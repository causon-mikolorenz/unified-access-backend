            "properties": {
                "base_url": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "image_location": {
                    "type": "string"
                },
                "logout_uri": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "redirect_uri": {
                    "type": "string"
                }
            }
        },
